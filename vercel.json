{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/business",
      "destination": "/shops",
      "permanent": true
    },
    {
      "source": "/business-studio",
      "destination": "/shops/studio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/geofence/:action",
      "destination": "/api/qr?gf=:action"
    },
    {
      "source": "/api/campaign/:action",
      "destination": "/api/qr?cp=:action"
    },
    {
      "source": "/o/:cid",
      "destination": "/offer"
    },
    {
      "source": "/r/:id",
      "destination": "/offer"
    },
    {
      "source": "/k/:code",
      "destination": "/api/qr?code=:code"
    },
    {
      "source": "/c/:id",
      "destination": "/studio"
    },
    {
      "source": "/m/:id",
      "destination": "/studio"
    },
    {
      "source": "/s/:id",
      "destination": "/site"
    },
    {
      "source": "/b/:id",
      "destination": "/biz"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?f=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?f=robots"
    },
    {
      "source": "/api/config",
      "destination": "/api/seo?f=config"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/img.js": {
      "maxDuration": 60
    }
  }
}
