{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/shops/pharmacy",
      "destination": "/shops/clinic",
      "permanent": true
    },
    {
      "source": "/business",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shops",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/business-studio",
      "destination": "/shops/studio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/geofence/:action",
      "destination": "/api/qr?gf=:action"
    },
    {
      "source": "/api/campaign/:action",
      "destination": "/api/qr?cp=:action"
    },
    {
      "source": "/o/:cid",
      "destination": "/offer"
    },
    {
      "source": "/r/:id",
      "destination": "/offer"
    },
    {
      "source": "/k/:code",
      "destination": "/api/qr?code=:code"
    },
    {
      "source": "/c/:id",
      "destination": "/studio"
    },
    {
      "source": "/m/:id",
      "destination": "/studio"
    },
    {
      "source": "/s/:id",
      "destination": "/site"
    },
    {
      "source": "/b/:id",
      "destination": "/biz"
    },
    {
      "source": "/bill/:id",
      "destination": "/bill"
    },
    {
      "source": "/ca/:id",
      "destination": "/ca"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?f=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?f=robots"
    },
    {
      "source": "/api/config",
      "destination": "/api/seo?f=config"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/(hq|admin|shops/dashboard|shops/studio|shops/login|account|studio|builder|login|reset-password|sales|print-codes|print-kit|creator|dashboard|bill|bill/.*|ca|ca/.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/img.js": {
      "maxDuration": 60
    },
    "api/qr.js": {
      "includeFiles": "assets/gst.v1.js"
    }
  }
}
